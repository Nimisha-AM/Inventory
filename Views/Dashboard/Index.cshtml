@{
    ViewData["Title"] = "Dashboard";
}

<h2>📊 Inventory Dashboard</h2>

<div style="display:flex; gap:20px; margin-top:20px;">

    <div style="padding:20px; background:#4CAF50; color:white; border-radius:10px; width:200px;">
        <h4>Products</h4>
        <h2>@ViewBag.TotalProducts</h2>
    </div>

    <div style="padding:20px; background:#2196F3; color:white; border-radius:10px; width:200px;">
        <h4>Variants</h4>
        <h2>@ViewBag.TotalVariants</h2>
    </div>

    <div style="padding:20px; background:#FF9800; color:white; border-radius:10px; width:200px;">
        <h4>Total Stock</h4>
        <h2>@ViewBag.TotalStock</h2>
    </div>

</div>